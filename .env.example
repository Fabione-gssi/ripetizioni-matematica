# Copia questo file in ".env" e inserisci i valori del tuo progetto Supabase
# (Dashboard Supabase > Project Settings > API). La chiave "anon" è pubblica per
# definizione: la sicurezza dei dati è garantita dalle regole RLS del database.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Facoltativo: nome della funzione del tutor AI come compare nel suo indirizzo (predefinito: ai-tutor)
# VITE_AI_FUNCTION=ai-tutor
